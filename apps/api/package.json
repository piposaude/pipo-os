{
  "name": "pipo-os-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/server.js",
    "db:migrate": "kysely migrate:latest",
    "db:rollback": "kysely migrate:down",
    "db:codegen": "kysely-codegen --out-file src/infrastructure/db-types.ts --url \"${DATABASE_URL:-postgresql://pipo_os:pipo_os@localhost:5432/pipo_os}\""
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/type-provider-zod": "^1.0.0",
    "@pipo-os/observability": "workspace:*",
    "fastify": "^5.11.3",
    "fastify-plugin": "^6.0.0",
    "kysely": "^0.29.5",
    "pg": "^8.11.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@pipo-os/eslint-config": "workspace:*",
    "@pipo-os/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.11.0",
    "eslint": "catalog:",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.21.0",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
