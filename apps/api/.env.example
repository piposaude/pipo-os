# Copie para apps/api/.env (git-ignored) e ajuste. Carregado automaticamente
# pelo `pnpm dev` via --env-file-if-exists; variáveis já exportadas no shell
# têm precedência sobre este arquivo.

# --- Login Google local -------------------------------------------------------
# Qual auth-service o login Google local vai usar. Escolha um:
AUTH_SERVICE_URL=https://auth-service.pipo.health
# AUTH_SERVICE_URL=https://auth-service.piposaude.com.br

# Client ID do OAuth "Backoffice" já registrado no GCP (o mesmo usado pelo tools).
# Peça a quem administra o secret `tools-auth`. Sem isso, só o login local funciona.
GOOGLE_OAUTH_CLIENT_ID=

# --- Login local (dev-login) --------------------------------------------------
# DEV_LOGIN_ENABLED já vem ligado pelo script `pnpm dev` — não defina aqui.
# Identidade da sessão local; precisa pertencer a ALLOWED_EMAIL_DOMAINS.
# DEV_LOGIN_EMAIL=dev@piposaude.com.br

# --- Outros -------------------------------------------------------------------
# DATABASE_URL=postgresql://pipo_os:pipo_os@localhost:5432/pipo_os
# ALLOWED_EMAIL_DOMAINS=piposaude.com.br,pipo.ai
# COOKIE_SECRET=
