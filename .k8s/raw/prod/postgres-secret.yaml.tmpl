apiVersion: v1
kind: Secret
metadata:
  name: pipo-os-postgres
  namespace: default
type: Opaque
stringData:
  POSTGRES_HOST: "psql.piposaude.com.br"
  POSTGRES_PORT: "5432"
  POSTGRES_USER: "pipo_os"
  POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}"
  POSTGRES_DB: "pipo_os"
  DATABASE_URL: "postgresql://pipo_os:${POSTGRES_PASSWORD_URLENC}@psql.piposaude.com.br:5432/pipo_os?sslmode=require"
