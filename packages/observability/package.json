{
  "name": "@pipo-os/observability",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./redact": {
      "types": "./dist/redact.d.ts",
      "default": "./dist/redact.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "default": "./dist/metrics.js"
    },
    "./sentry-node": {
      "types": "./dist/sentry-node.d.ts",
      "default": "./dist/sentry-node.js"
    },
    "./sentry-react": {
      "types": "./dist/sentry-react.d.ts",
      "default": "./dist/sentry-react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "@sentry/react": "^10.70.0",
    "fastify": "^5.11.3",
    "fastify-metrics": "^13.2.1",
    "fastify-plugin": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pipo-os/eslint-config": "workspace:*",
    "@pipo-os/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^18.2.48",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
