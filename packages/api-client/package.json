      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pipo-os/eslint-config": "workspace:*",
    "@pipo-os/typescript-config": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "@types/react": "^18.2.48",
    "eslint": "catalog:",
    "openapi-typescript": "^7.6.1",
    "react": "^18.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
