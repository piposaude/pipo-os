      "expected": ["da-ana-atrasado", "do-bruno"]
    },
    {
      "name": "two fields are an AND",
      "filter": {
        "statuses": ["missing-documents", "incorrect-data"],
        "companyIds": ["00000000-0000-4000-8000-0000000000a1"]
      },
      "expected": ["da-ana-atrasado"]
