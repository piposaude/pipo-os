      "expected": ["fechado", "livre-urgente"]
    },
    {
      "name": "actionDateBefore cuts by day and drops the ones with no date",
      "filter": { "actionDateBefore": "2026-08-31" },
      "expected": ["da-ana-atrasado"]
    },
    {
      "name": "urgentBy is urgent OR overdue, the filter's only cross-field OR",
