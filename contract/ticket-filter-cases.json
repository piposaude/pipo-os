      "filter": { "tags": ["vip", "retorno"] },
      "expected": ["da-ana-atrasado"]
    },
    {
      "name": "a single tag still matches every ticket carrying it",
      "filter": { "tags": ["vip"] },
      "expected": ["da-ana-atrasado", "fechado", "livre-urgente"]
